@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Beranda";
}

<style>
    /*--------------------------------------------------------------
    # Custom Modern Styling for Main Page
    --------------------------------------------------------------*/
    :root {
        --primary-blue: #0284c7;
        --primary-hover: #0369a1;
        --secondary-dark: #0f172a;
        --text-muted-custom: #64748b;
        --card-bg: #ffffff;
        --section-light: #f8fafc;
        --border-color: #e2e8f0;
    }

    /* Section Global Styling */
    .landing-section {
        padding: 80px 0;
        position: relative;
    }

    .landing-section.bg-light-subtle {
        background-color: var(--section-light);
    }

    .section-badge {
        display: inline-block;
        padding: 6px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-radius: 50px;
        background-color: rgba(2, 132, 199, 0.1);
        color: var(--primary-blue);
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--secondary-dark);
        margin-bottom: 15px;
        line-height: 1.3;
    }

    .section-subtitle {
        color: var(--text-muted-custom);
        font-size: 1.05rem;
        max-width: 650px;
        margin: 0 auto 40px auto;
        line-height: 1.6;
    }

    /*--------------------------------------------------------------
    # Hero Carousel
    --------------------------------------------------------------*/
    .hero-carousel-wrapper {
        position: relative;
        overflow: hidden;
    }

    #heroCarousel {
        width: 100%;
        height: 82vh;
        min-height: 580px;
        max-height: 720px;
    }

    .hero-carousel-wrapper .carousel-inner,
    .hero-carousel-wrapper .carousel-item {
        height: 100%;
    }

    .hero-carousel-wrapper .carousel-item img {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.55) 0%, rgba(15, 23, 42, 0.75) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-content {
        max-width: 850px;
        color: #ffffff;
        padding: 0 20px;
        text-align: center;
        margin-top: 40px; /* offset for fixed header */
    }

    .hero-content .hero-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
    }

    .hero-content h1 {
        font-size: 2.8rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.25;
        margin-bottom: 20px;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    .hero-content p {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 30px;
        line-height: 1.6;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    }

    .hero-btn-primary {
        background-color: var(--primary-blue);
        color: #ffffff;
        padding: 12px 28px;
        font-weight: 600;
        border-radius: 50px;
        border: 2px solid var(--primary-blue);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .hero-btn-primary:hover {
        background-color: var(--primary-hover);
        border-color: var(--primary-hover);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
    }

    .hero-btn-outline {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(6px);
        color: #ffffff;
        padding: 12px 28px;
        font-weight: 600;
        border-radius: 50px;
        border: 2px solid rgba(255, 255, 255, 0.7);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .hero-btn-outline:hover {
        background: #ffffff;
        color: var(--secondary-dark);
        border-color: #ffffff;
        transform: translateY(-2px);
    }

    .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin: 0 6px;
        background-color: rgba(255, 255, 255, 0.6);
        border: none;
        transition: all 0.3s ease;
    }

    .carousel-indicators .active {
        width: 28px;
        border-radius: 10px;
        background-color: var(--primary-blue);
    }

    /*--------------------------------------------------------------
    # Highlights / Stats Floating Card
    --------------------------------------------------------------*/
    .stats-card-container {
        margin-top: -60px;
        position: relative;
        z-index: 10;
        padding: 0 15px;
    }

    .stats-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid var(--border-color);
        padding: 30px 20px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 10px 15px;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 12px;
        background: rgba(2, 132, 199, 0.1);
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .stat-info h4 {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--secondary-dark);
        margin: 0 0 2px 0;
    }

    .stat-info p {
        font-size: 0.88rem;
        color: var(--text-muted-custom);
        margin: 0;
    }

    /*--------------------------------------------------------------
    # About Section
    --------------------------------------------------------------*/
    .about-img-box {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .about-img-box img {
        width: 100%;
        height: 100%;
        min-height: 380px;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .about-img-box:hover img {
        transform: scale(1.03);
    }

    .about-floating-badge {
        position: absolute;
        bottom: 25px;
        left: 25px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(6px);
        padding: 15px 22px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        border-left: 4px solid var(--primary-blue);
    }

    .about-floating-badge h5 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        color: var(--secondary-dark);
    }

    .about-floating-badge span {
        font-size: 0.85rem;
        color: var(--text-muted-custom);
    }

    .feature-check-list {
        list-style: none;
        padding: 0;
        margin: 25px 0 0 0;
    }

    .feature-check-list li {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
        font-size: 1rem;
        color: #334155;
    }

    .feature-check-list li i {
        color: var(--primary-blue);
        font-size: 1.2rem;
        line-height: 1.4;
    }

    /*--------------------------------------------------------------
    # Services Cards
    --------------------------------------------------------------*/
    .service-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
        transition: all 0.35s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(2, 132, 199, 0.12);
        border-color: rgba(2, 132, 199, 0.3);
    }

    .service-card-img {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

    .service-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .service-card:hover .service-card-img img {
        transform: scale(1.08);
    }

    .service-card-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .service-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(2, 132, 199, 0.1);
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 16px;
    }

    .service-card-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--secondary-dark);
        margin-bottom: 10px;
    }

    .service-card-desc {
        font-size: 0.95rem;
        color: var(--text-muted-custom);
        line-height: 1.6;
        margin-bottom: 0;
        flex-grow: 1;
    }

    /*--------------------------------------------------------------
    # Vision & Mission
    --------------------------------------------------------------*/
    .vision-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 28px;
        border: 1px solid var(--border-color);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
        margin-bottom: 24px;
        transition: all 0.3s ease;
    }

    .vision-card:hover {
        border-color: rgba(2, 132, 199, 0.35);
        box-shadow: 0 12px 28px rgba(2, 132, 199, 0.08);
    }

    .vision-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
    }

    .vision-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(2, 132, 199, 0.1);
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .vision-card h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--secondary-dark);
        margin: 0;
    }

    .vision-card p {
        font-size: 0.98rem;
        color: var(--text-muted-custom);
        line-height: 1.65;
        margin: 0;
    }

    /*--------------------------------------------------------------
    # Portfolio Showcase Cards
    --------------------------------------------------------------*/
    .portfolio-item {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
        margin-bottom: 30px;
        transition: all 0.3s ease;
    }

    .portfolio-item:hover {
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
    }

    .portfolio-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 100%;
        min-height: 240px;
    }

    .portfolio-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .portfolio-item:hover .portfolio-img-wrapper img {
        transform: scale(1.05);
    }

    .portfolio-body {
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .portfolio-tag {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--primary-blue);
        margin-bottom: 8px;
    }

    .portfolio-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--secondary-dark);
        margin-bottom: 12px;
    }

    .portfolio-text {
        font-size: 0.95rem;
        color: var(--text-muted-custom);
        line-height: 1.6;
        margin-bottom: 16px;
    }

    /*--------------------------------------------------------------
    # Article Cards
    --------------------------------------------------------------*/
    .article-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
        transition: all 0.35s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .article-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.08);
        border-color: rgba(2, 132, 199, 0.3);
    }

    .article-img {
        height: 190px;
        overflow: hidden;
        position: relative;
    }

    .article-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .article-card:hover .article-img img {
        transform: scale(1.06);
    }

    .article-date-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(4px);
        color: #ffffff;
        font-size: 0.78rem;
        padding: 4px 10px;
        border-radius: 6px;
    }

    .article-body {
        padding: 22px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .article-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--secondary-dark);
        margin-bottom: 10px;
        line-height: 1.4;
    }

    .article-snippet {
        font-size: 0.9rem;
        color: var(--text-muted-custom);
        line-height: 1.6;
        margin-bottom: 18px;
        flex-grow: 1;
    }

    .article-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--primary-blue);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: gap 0.2s ease;
    }

    .article-link:hover {
        color: var(--primary-hover);
        gap: 10px;
    }

    /*--------------------------------------------------------------
    # Clean Action Buttons
    --------------------------------------------------------------*/
    .btn-action-primary {
        background-color: var(--primary-blue);
        color: #ffffff;
        font-weight: 600;
        padding: 10px 28px;
        border-radius: 50px;
        border: 2px solid var(--primary-blue);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-action-primary:hover {
        background-color: var(--primary-hover);
        border-color: var(--primary-hover);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(2, 132, 199, 0.3);
    }

    .btn-action-outline {
        background-color: transparent;
        color: var(--primary-blue);
        font-weight: 600;
        padding: 10px 28px;
        border-radius: 50px;
        border: 2px solid var(--primary-blue);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .btn-action-outline:hover {
        background-color: var(--primary-blue);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(2, 132, 199, 0.25);
    }

    /* Responsive adjustments */
    @@media (max-width: 991.98px) {
        .hero-content h1 {
            font-size: 2.2rem;
        }
        .stats-card-container {
            margin-top: -30px;
        }
        .landing-section {
            padding: 60px 0;
        }
    }

    @@media (max-width: 767.98px) {
        .hero-content h1 {
            font-size: 1.8rem;
        }
        .hero-content p {
            font-size: 1rem;
        }
        .section-title {
            font-size: 1.8rem;
        }
        .stats-card-container {
            margin-top: 20px;
        }
        #heroCarousel {
            height: 70vh;
            min-height: 480px;
        }
    }
</style>

<!-- Hero Section with Modern Carousel -->
<div class="hero-carousel-wrapper">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
            <!-- Slide 1 -->
            <div class="carousel-item active">
                <img src="~/assets/img/hero-carousel/hero-carousel-1.jpg" alt="Hero Image 1">
                <div class="hero-overlay">
                    <div class="hero-content" data-aos="fade-up" data-aos-duration="800">
                        <span class="hero-badge"><i class="bi bi-droplet-half me-1"></i> Rekayasa Sumber Daya Air</span>
                        <h1>Solusi Terpadu Rekayasa Sumber Daya Air Berkelanjutan</h1>
                        <p>Konsultan profesional dan berpengalaman dalam perencanaan, review desain, dan pengawasan teknis pekerjaan sumber daya air di seluruh wilayah Indonesia.</p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a href="#layanan" class="hero-btn-primary">Lihat Layanan <i class="bi bi-arrow-right"></i></a>
                            <a href="#tentang" class="hero-btn-outline">Tentang Kami</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="carousel-item">
                <img src="~/assets/img/hero-carousel/hero-carousel-2.jpg" alt="Hero Image 2">
                <div class="hero-overlay">
                    <div class="hero-content">
                        <span class="hero-badge"><i class="bi bi-shield-check me-1"></i> Presisi & Keandalan</span>
                        <h1>Analisa Hidrologi & Sistem Peringatan Dini Banjir</h1>
                        <p>Mengintegrasikan kajian hidrologi komprehensif dengan perencanaan sistem peringatan dini (FEWS) untuk perlindungan infrastruktur dan masyarakat.</p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a asp-controller="Service" asp-action="Index" class="hero-btn-primary">Katalog Layanan <i class="bi bi-arrow-right"></i></a>
                            <a asp-controller="Portofolio" asp-action="Index" class="hero-btn-outline">Portofolio Pekerjaan</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="carousel-item">
                <img src="~/assets/img/hero-carousel/hero-carousel-3.jpg" alt="Hero Image 3">
                <div class="hero-overlay">
                    <div class="hero-content">
                        <span class="hero-badge"><i class="bi bi-award me-1"></i> Mutu & Dedikasi</span>
                        <h1>Komitmen Mutu dan Ketepatan Waktu</h1>
                        <p>Didukung oleh tim tenaga ahli bersertifikat dan berdedikasi tinggi demi memberikan solusi bernilai tambah bagi setiap pelanggan.</p>
                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <a asp-controller="Portofolio" asp-action="Index" class="hero-btn-primary">Jelajahi Proyek <i class="bi bi-arrow-right"></i></a>
                            <a href="#tentang" class="hero-btn-outline">Profil Perusahaan</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<!-- Floating Key Highlights Bar -->
<div class="container stats-card-container" data-aos="fade-up" data-aos-delay="100">
    <div class="stats-card">
        <div class="row g-3">
            <div class="col-lg-3 col-sm-6">
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
                    <div class="stat-info">
                        <h4>2021</h4>
                        <p>Tahun Berdiri</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-water"></i></div>
                    <div class="stat-info">
                        <h4>SDA & Keairan</h4>
                        <p>Fokus & Spesialisasi</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                    <div class="stat-info">
                        <h4>Tenaga Ahli</h4>
                        <p>Profesional & Berlisensi</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="stat-item">
                    <div class="stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                    <div class="stat-info">
                        <h4>Presisi & Mutu</h4>
                        <p>Standar Kualitas Terbaik</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- About Section -->
<section id="tentang" class="landing-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="about-img-box">
                    <img src="~/assets/img/about.jpg" alt="Tentang PT Tirta Rekayasa Konsultan">
                    <div class="about-floating-badge">
                        <h5>PT. Tirta Rekayasa Konsultan</h5>
                        <span>Mitra Rekayasa Terpercaya</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <span class="section-badge">Tentang Kami</span>
                <h2 class="section-title">Konsultan Perencanaan & Pengawasan Bidang Sumber Daya Air</h2>
                <p class="text-secondary" style="line-height: 1.7; font-size: 1.05rem;">
                    <strong>PT. Tirta Rekayasa Konsultan</strong> berdiri sejak tahun 2021 dan bergerak aktif dalam bidang konsultan perencanaan serta pengawasan teknik sumber daya air. Kami didukung oleh tenaga ahli profesional yang berpengalaman dalam merencanakan, mereview, dan mengawasi pekerjaan keairan strategis.
                </p>

                <ul class="feature-check-list">
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Didukung konsultan spesialis yang berdedikasi tinggi dan bersertifikasi keahlian.</span>
                    </li>
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Metodologi komprehensif, berbasis data lapangan akurat dan pemodelan mutakhir.</span>
                    </li>
