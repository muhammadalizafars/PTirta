@using PTirta.ViewModels;
@model ChangePasswordVM;

@{
    ViewData["Title"] = "Ubah Kata Sandi";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <div class="auth-header">
            <a asp-controller="Main" asp-action="Index">
                <img src="~/assets/img/Logo/Logo.png" alt="Logo PT Tirta" class="auth-logo" />
            </a>
            <h2 class="auth-title">Ubah Kata Sandi</h2>
            <p class="auth-subtitle">Silakan buat kata sandi baru untuk akun Anda</p>
        </div>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group-custom">
                    <span class="input-icon-wrapper"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control-custom" readonly />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Kata Sandi Baru</label>
                <div class="input-group-custom">
                    <span class="input-icon-wrapper"><i class="bi bi-lock"></i></span>
                    <input asp-for="NewPassword" class="form-control-custom" placeholder="Minimal 6 karakter" type="password" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label">Konfirmasi Kata Sandi Baru</label>
                <div class="input-group-custom">
                    <span class="input-icon-wrapper"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="ConfirmNewPassword" class="form-control-custom" placeholder="Ulangi kata sandi baru" type="password" />
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth-primary">
                <i class="bi bi-check2-circle"></i> Simpan Kata Sandi
            </button>

            <div class="auth-divider">
                <span>atau</span>
            </div>

            <div class="text-center">
                <a asp-controller="Auth" asp-action="Login" class="auth-back-link">
                    <i class="bi bi-arrow-left"></i> Kembali ke Halaman Masuk
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
