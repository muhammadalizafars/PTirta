@using PTirta.ViewModels;
@model VerifyEmailVM;

@{
    ViewData["Title"] = "Verifikasi Email";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <div class="auth-header">
            <a asp-controller="Main" asp-action="Index">
                <img src="~/assets/img/Logo/Logo.png" alt="Logo PT Tirta" class="auth-logo" />
            </a>
            <h2 class="auth-title">Verifikasi Email</h2>
            <p class="auth-subtitle">Masukkan alamat email Anda untuk pemulihan kata sandi</p>
        </div>

        <form asp-action="VerifyEmail" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label">Email Terdaftar</label>
                <div class="input-group-custom">
                    <span class="input-icon-wrapper"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control-custom" placeholder="nama@email.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth-primary">
                <i class="bi bi-send-fill"></i> Kirim Verifikasi
            </button>

            <div class="auth-divider">
                <span>atau</span>
            </div>

            <div class="text-center">
                <a asp-controller="Auth" asp-action="Login" class="auth-back-link">
                    <i class="bi bi-arrow-left"></i> Kembali ke Halaman Masuk
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
