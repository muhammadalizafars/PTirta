## A streamlined .gitignore for modern .NET + Vue.js projects
## Get latest .NET baseline from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results (.NET)
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
bin/
obj/
Debug/
Release/

# Kredensial & Environment lokal (Jangan push password/connection string)
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
appsettings.production.json

# .NET Core & NuGet Packages
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Vue.js / Frontend / Node.js
node_modules/
.npm/
dist/
dist-ssr/
*.local

# IDE / Editor Specific (Visual Studio, VS Code, Rider)
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Others & Logs
~$*
*~
CodeCoverage/
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit / Test Results
*.VisualState.xml
TestResult.xml
nunit-*.xml
